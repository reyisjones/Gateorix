{
  "name": "@gateorix/bridge",
  "version": "0.1.0",
  "description": "Gateorix JavaScript/TypeScript bridge — frontend SDK for communicating with the host core",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "dist/LICENSE", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/reyisjones/Gateorix.git",
    "directory": "sdk/js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
